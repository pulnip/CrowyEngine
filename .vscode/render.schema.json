{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "textures": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "format"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "format": {
                        "type": "string",
                        "enum": [
                            "R8_UNORM",
                            "R8_SNORM",
                            "R8_UINT",
                            "R8_SINT",
                            "R16_UNORM",
                            "R16_SNORM",
                            "R16_UINT",
                            "R16_SINT",
                            "R16_FLOAT",
                            "RG8_UNORM",
                            "RG8_SNORM",
                            "RG8_UINT",
                            "RG8_SINT",
                            "R32_UINT",
                            "R32_SINT",
                            "R32_FLOAT",
                            "RG16_UNORM",
                            "RG16_SNORM",
                            "RG16_UINT",
                            "RG16_SINT",
                            "RG16_FLOAT",
                            "RGBA8_UNORM",
                            "RGBA8_UNORM_SRGB",
                            "RGBA8_SNORM",
                            "RGBA8_UINT",
                            "RGBA8_SINT",
                            "BGRA8_UNORM",
                            "BGRA8_UNORM_SRGB",
                            "RG32_UINT",
                            "RG32_SINT",
                            "RG32_FLOAT",
                            "RGB32_FLOAT",
                            "RGBA16_UNORM",
                            "RGBA16_SNORM",
                            "RGBA16_UINT",
                            "RGBA16_SINT",
                            "RGBA16_FLOAT",
                            "RGBA32_UINT",
                            "RGBA32_SINT",
                            "RGBA32_FLOAT",
                            "D16_UNORM",
                            "D24_UNORM_S8_UINT",
                            "D32_FLOAT",
                            "D32_FLOAT_S8_UINT"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "samplers": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "minFilter": {
                        "type": "string",
                        "enum": [
                            "Linear",
                            "Nearest"
                        ]
                    },
                    "magFilter": {
                        "type": "string",
                        "enum": [
                            "Linear",
                            "Nearest"
                        ]
                    },
                    "mipFilter": {
                        "type": "string",
                        "enum": [
                            "Linear",
                            "Nearest"
                        ]
                    },
                    "filter": {
                        "type": "string",
                        "enum": [
                            "Linear",
                            "Nearest"
                        ]
                    },
                    "addressU": {
                        "type": "string",
                        "enum": [
                            "Wrap",
                            "Clamp",
                            "Mirror",
                            "Border"
                        ]
                    },
                    "addressV": {
                        "type": "string",
                        "enum": [
                            "Wrap",
                            "Clamp",
                            "Mirror",
                            "Border"
                        ]
                    },
                    "addressW": {
                        "type": "string",
                        "enum": [
                            "Wrap",
                            "Clamp",
                            "Mirror",
                            "Border"
                        ]
                    },
                    "address": {
                        "type": "string",
                        "enum": [
                            "Wrap",
                            "Clamp",
                            "Mirror",
                            "Border"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "cbuffers": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["name", "type", "data"],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "Float",
                                        "Float2",
                                        "Float3",
                                        "Float4"
                                    ]
                                },
                                "data": {}
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "additionalProperties": false
            }
        },
        "passes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "pipelines"],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "pipelines": {
                        "type": "array",
                        "required": ["outputs", "metal_shader", "d3d_shader"],
                        "properties": {
                            "inputs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "outputs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "depthOutput": {
                                "type": "string"
                            },
                            "fs_samplers": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": ["name", "slot"],
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "slot": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            },
                            "fs_cbuffers": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": ["name", "slot"],
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "slot": {
                                            "type": "integer"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "metal_shader": {
                                "type": "object",
                                "required": ["vs_file", "vs_func", "fs_file", "fs_func"],
                                "properties": {
                                    "vs_file": {
                                        "type": "string"
                                    },
                                    "vs_func": {
                                        "type": "string"
                                    },
                                    "fs_file": {
                                        "type": "string"
                                    },
                                    "fs_func": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "d3d_shader": {
                                "type": "object",
                                "required": ["vs_file", "vs_func", "fs_file", "fs_func"],
                                "properties": {
                                    "vs_file": {
                                        "type": "string"
                                    },
                                    "vs_func": {
                                        "type": "string"
                                    },
                                    "fs_file": {
                                        "type": "string"
                                    },
                                    "fs_func": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    }
}