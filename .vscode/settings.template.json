{
    "cmake.useVsDeveloperEnvironment": "always",
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "*.hpp": "cpp",
        "*.cpp": "cpp"
    },
    "files.exclude": {
        "**/D3D11RHI/**": true,
        "**/D3D12RHI/**": true,
        "**/*.hlsli": true,
        "**/*.hlsl": true,
        "**/MetalRHI/**": true,
        "**/*.metal": true
    },
    "search.exclude": {
        "**/D3D11RHI/**": true,
        "**/D3D12RHI/**": true,
        "**/*.hlsli": true,
        "**/*.hlsl": true,
        "**/MetalRHI/**": true,
        "**/*.metal": true
    },
    "clangd.path": "/path/to/clangd",
    "evenBetterToml.schema.associations": {
        "input\\.toml$": "file:///path/to/.vscode/input.schema.json"
    }
}