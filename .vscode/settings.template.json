{
    "cmake.useVsDeveloperEnvironment": "always",
    "cmake.modifyLists.addNewSourceFiles": "no",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modifications",
    "files.associations": {
        "*.toml": "toml",
        "*.h": "c",
        "*.c": "c",
        "*.hpp": "cpp",
        "*.cpp": "cpp"
    },
    "files.exclude": {
        ".cache/": true,
        ".vs": true,
        "**/DX12RHI/**": true,
        "**/MetalRHI/**": true
    },
    "github.copilot.enable": {
        "*": false
    },
    "search.exclude": {
        ".cache/": true,
        ".vs": true,
        "**/DX12RHI/**": true,
        "**/MetalRHI/**": true
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/path/to/clangd",
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    }
}