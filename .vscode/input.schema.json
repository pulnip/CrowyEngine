{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "actions": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "bindings"],
                "properties": {
                    "name": { "type": "string" },
                    "bindings": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["device", "keyCode", "keyState"],
                            "properties": {
                                "device": {
                                    "type": "string",
                                    "enum": ["keyboard"]
                                },
                                "keyCode": {
                                    "type": "string",
                                    "enum": [
                                        "num0", "num1", "num2", "num3", "num4",
                                        "num5", "num6", "num7", "num8", "num9",
                                        "a", "b", "c", "d", "e", "f", "g", "h", "i", "j",
                                        "k", "l", "m", "n", "o", "p", "q", "r", "s", "t",
                                        "u", "v", "w", "x", "y", "z",
                                        "f1", "f2", "f3",  "f4",  "f5",  "f6",
                                        "f7", "f8", "f9", "f10", "f11", "f12",
                                        "ctrl", "alt", "shift",
                                        "tab", "space", "enter", "escape"
                                    ]
                                },
                                "keyState": {
                                    "type": "string",
                                    "enum": ["None", "Pressed", "Released", "Held"]
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}