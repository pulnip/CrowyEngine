{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Game (macOS)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/Game/Crowy",
            "args": [
                "--width=800", "--height=600",
                "--scene=scene.toml",
                "--render=render.toml"
            ],
            "cwd": "${workspaceFolder}/Game"
        },
        {
            "name": "Game (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Game/Crowy.exe",
            "args": [
                "--width=800", "--height=600",
                "--scene=scene.toml",
                "--render=render.toml"
            ],
            "cwd": "${workspaceFolder}/Game"
        }
    ]
}