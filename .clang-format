---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

ColumnLimit: 80
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: All
FixNamespaceComments: false
SpaceAfterTemplateKeyword: false

# K&R everywhere except namespaces, which are Allman.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: true
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# A symbol that follows a name is attached to it.
SpaceBeforeParens: Never
SpaceBeforeInheritanceColon: false
SpaceBeforeRangeBasedForLoopColon: false
SpaceBeforeCaseColon: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeCpp11BracedList: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesInAngles: Never

PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

IndentCaseLabels: false
IndentPPDirectives: None
IndentRequiresClause: true
RequiresClausePosition: OwnLine
AlwaysBreakTemplateDeclarations: Yes

AllowShortFunctionsOnASingleLine: Inline
AllowShortBlocksOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline

BinPackParameters: false
BinPackArguments: false
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: false
AlignAfterOpenBracket: BlockIndent
# Break the parameter list, not the return type, when a signature runs long.
PenaltyReturnTypeOnItsOwnLine: 1000

BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4
PackConstructorInitializers: NextLineOnly

# Own header first (Priority 0 via IncludeIsMainRegex), then <std>, then
# <external>, then "project". Alphabetical within each group.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeIsMainRegex: '$'
IncludeCategories:
  - Regex: '^<[^.]*>$'
    Priority: 1
  # Jolt requires Jolt.h before any other Jolt header.
  - Regex: '^<Jolt/Jolt\.h>$'
    Priority: 2
    SortPriority: 2
  - Regex: '^<.*>$'
    Priority: 2
    SortPriority: 3
  - Regex: '^".*"$'
    Priority: 3
    SortPriority: 4

# The registration macros open and close a namespace or a specialization.
# Each registration still sits in clang-format off: the formatter indents a
# chain's second call one level deeper than its first.
MacroBlockBegin: '^CROWY_(STRUCT|COMPONENT|SYSTEM|OBJECT|ENUM_BEGIN)$'
MacroBlockEnd: '^CROWY_(STRUCT_END|COMPONENT_END|SYSTEM_END|OBJECT_END|ENUM_END)$'

EmptyLineBeforeAccessModifier: LogicalBlock
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
InsertNewlineAtEOF: true
---
